[Unit]
Description=SyncLens: Qt wrapper for the Resilio Sync WebUI
Documentation=https://github.com/uairhahs/SyncLens
# Wait for the graphical session so the tray and WebEngine are available.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Filled in by CMake with the install location; the per-user installer
# (scripts/install.sh --user) rewrites it to the installed path.
ExecStart=@SYNCLENS_BINDIR@/synclens
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
