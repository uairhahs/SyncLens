# Maintainer: uairhahs <https://github.com/uairhahs>
pkgname=synclens
pkgver=0.2.5
pkgrel=1
pkgdesc="Unofficial Qt wrapper for the Resilio Sync WebUI"
arch=('x86_64')
url="https://github.com/uairhahs/SyncLens"
license=('MIT')
depends=(
    'qt6-webengine'
    'qt6-base'
    'qt6-svg'
)
optdepends=(
    'libsecret: secure credential storage via GNOME Keyring or KWallet'
)
makedepends=(
    'cmake'
    'ninja'
    'qt6-tools'       # for moc/rcc/uic
    'libsecret'       # optional at runtime, required at build time to enable the feature
    'pkg-config'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/uairhahs/SyncLens/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('ad211b30e8b3ef29e75d3fcbad6a8eaf253f628fb8694bc5a170b3ec7eb92b0c')

prepare() {
    cd "SyncLens-$pkgver"
}

build() {
    cmake \
        -B build \
        -S "SyncLens-$pkgver" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "SyncLens-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
