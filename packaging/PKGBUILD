# Maintainer: uairhahs <https://github.com/uairhahs>
#
# Builds the SyncLens checkout this file lives in, so `makepkg -si` from a
# clone always packages exactly that code and needs no checksum update after
# tagging. Release packages are built the same way by
# .github/workflows/release.yml and attached to each GitHub release.
pkgname=synclens
pkgver=0.2.5
pkgrel=1
pkgdesc="Unofficial Qt wrapper for the Resilio Sync WebUI"
arch=('x86_64')
url="https://github.com/uairhahs/SyncLens"
license=('MIT')
depends=(
    'qt6-webengine'
    'qt6-base'
    'qt6-svg'
)
optdepends=(
    'libsecret: secure credential storage via GNOME Keyring or KWallet'
)
makedepends=(
    'cmake'
    'ninja'
    'qt6-tools'       # for moc/rcc/uic
    'libsecret'       # optional at runtime, required at build time to enable the feature
    'pkgconf'
)
install=synclens.install
source=()

_srcroot() {
    # The repository root: the parent of the directory holding this PKGBUILD.
    realpath "$startdir/.."
}

build() {
    cmake \
        -B build \
        -S "$(_srcroot)" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$(_srcroot)/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
